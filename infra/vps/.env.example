# Copy outside Git as /opt/secondbrain/shared/runtime.env and replace every value.
# `preflight.sh` rejects example values and missing secret files. For a new
# host prefer scripts/init-runtime.py, which generates Desk credentials safely.
BRAIN_DOMAIN=brain.example.com
ACME_EMAIL=ops@example.com
SECRETS_DIR=/opt/secondbrain/shared/secrets
BRAIN_PRIVATE_DIR=/opt/secondbrain/shared/brain
BACKUP_DIR=/opt/secondbrain/backups
BACKUP_RETENTION_DAYS=30
