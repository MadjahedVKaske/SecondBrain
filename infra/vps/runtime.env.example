# Copy outside Git as /opt/secondbrain/shared/runtime.env and replace every value.
# The generator writes the same five Desk-only settings with real paths/values.
BRAIN_DOMAIN=brain.example.com
ACME_EMAIL=ops@example.com
SECRETS_DIR=/opt/secondbrain/shared/secrets
BRAIN_PRIVATE_DIR=/opt/secondbrain/shared/brain
BACKUP_DIR=/opt/secondbrain/backups
BACKUP_RETENTION_DAYS=30
# Set only for the one-shot, locally approved initial import profile.
APPROVED_DUMP_DIR=/opt/secondbrain/shared/import
INITIAL_DUMP_SHA256=replace-with-approved-local-dump-sha256
INITIAL_IMPORT_CONFIRM=EMPTY_DB_ONLY
# These are recorded by the bootstrap helper; APP_IMAGE is exported only by
# the root deploy wrapper for the exact release being activated.
CADDY_IMAGE=caddy@sha256:replace-with-recorded-digest
MYSQL_IMAGE=mysql@sha256:replace-with-recorded-digest
